  "definitions": {
    "relevance": {
      "dataset label": "track's `label` equals the target (sad/happy/energetic/calm). Labels come from the Moodify dataset, which describes them as model-generated; not human per-track ground truth.",
      "derived rule": "track's `derived_angry` is true: valence <= 25th pct, energy >= 75th pct, loudness >= 75th pct of the catalog. A feature rule, not a label.",
      "derived (experimental rule)": "track's `derived_stressed` is true: the stressed percentile rule after the failed-analysis and spoken-word guards. Experimental, not a label.",
      "request": "a request's relevant set is the union of its targets' sets (app mood -> targets via MOOD_TO_MUSIC_TARGETS; 'Cheer me up' first maps the mood through MOOD_TO_TAGS_CHEER).",
      "app_mood_targets": {
        "happy": [
          "happy"
        ],
        "sad": [
          "sad"
        ],
        "energetic": [
          "energetic"
        ],
        "chill": [
          "calm"
        ],
        "angry": [
          "angry"
        ],
        "stressed": [
          "stressed"
        ]
      },
      "label_names": {
        "0": "sad",
        "1": "happy",
        "2": "energetic",
        "3": "calm"
      }
    },
    "precision@k": "share of the first k tracks that are relevant",
    "recall@k": "relevant tracks in the first k / all relevant tracks in the 278k catalog (tens of thousands per target, so recall@30 is tiny by construction)",
    "ndcg@k": "binary-relevance NDCG; ideal DCG has min(k, |relevant|) relevant tracks at the top",
    "diversity": "mean pairwise Euclidean distance between a list's tracks in the 9 audio features, each z-scored over the catalog (no genre: the catalog has none)",
    "duplicates": "repeated track IDs within one list",
    "mood_consistency": "per target: share of served slots whose track satisfies that target's definition",
    "classifier_agreement_on_label_targets": "for served tracks whose label is a requested label target, share where the 278k classifier's predicted mood equals the label. Circular: the ranking itself prefers high classifier probability.",
    "catalog_coverage": "unique tracks served across all evaluation requests / catalog tracks",
    "stability": "over `runs` requests with different seeds: unique tracks, mean pairwise Jaccard overlap of the lists, and whether the same seed reproduces the same list",
    "random_catalog_baseline": "uniform random tracks from the whole catalog",
    "random_eligible_baseline": "the recommender's per-target shares, filled uniformly at random from each target's candidates (the recommender minus its classifier ranking)"
  },
  "list_size": 30,
