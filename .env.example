# Copy to .env and fill in. .env is gitignored -- never commit real keys.

# Optional. The running app uses it for movie details (src/movie_details.py):
# a fallback poster when a dataset poster link is broken, and where to stream,
# rent or buy in India. Without it the app still runs; those details show as
# unavailable. The optional TMDB movie dataset builder needs it too.
# The music catalog is built offline from the 278k dataset by
# train_music_278k.py; no Spotify credentials are used anywhere.
TMDB_API_KEY=

# Flask server settings (all optional).
# FLASK_DEBUG enables the Werkzeug debugger -- local development only.
FLASK_DEBUG=0
FLASK_HOST=127.0.0.1
FLASK_PORT=5000
LOG_LEVEL=INFO
